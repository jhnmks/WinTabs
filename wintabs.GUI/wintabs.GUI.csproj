<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\wintabs\Icon4.ico</ApplicationIcon>
    <Product>WinTabs</Product>
    <AssemblyTitle>WinTabs</AssemblyTitle>
    <Copyright>Copyright 2024 Vesko Karaganev</Copyright>
    <Authors>Vesko Karaganev</Authors>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <StartupObject>wintabs.GUI.Program</StartupObject>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <CetCompat>false</CetCompat>
    <AssemblyName>$(MSBuildProjectName.Replace(".", "-"))</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\wintabs\wintabs.csproj" />
  </ItemGroup>

</Project>
