<UserControl x:Class="wintabs.Controls.TilingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:wintabs.Controls"
             xmlns:viewmodels="clr-namespace:wintabs.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:TilingPanelViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="20"
             d:DesignWidth="800">
    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            ClipToBounds="True" PreviewMouseLeftButtonDown="OnGroupMouseDown">
        <DockPanel>
            <Border DockPanel.Dock="Left" Padding="6,0,8,0" Background="Transparent"
                    AutomationProperties.Name="Move tab group" ToolTip="Drag to move this group. Drop on another tab bar to swap groups.">
                <!-- Numbered badge: identifies the group and doubles as its drag handle. -->
                <Border MinWidth="{Binding Overlay.IconSize}" Height="{Binding Overlay.IconSize}" Padding="3,0"
                        CornerRadius="8" Background="#C42B1C" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <TextBlock Text="{Binding GroupNumber}" Foreground="White" FontWeight="SemiBold"
                               FontSize="{Binding Overlay.FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" />
                </Border>
            </Border>
            <local:TabBar ItemsSource="{Binding Path=ChildNodes}" />
        </DockPanel>
    </Border>
</UserControl>
