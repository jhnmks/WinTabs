<UserControl x:Class="wintabs.Controls.TilingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:wintabs.Controls"
             xmlns:viewmodels="clr-namespace:wintabs.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:TilingPanelViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="20"
             d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <StackPanel>
        <Border Height="{Binding RowHeight}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Left" Margin="3,0,5,0" PreviewMouseLeftButtonDown="OnGroupMouseDown">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource GroupNumberBadgeStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsContainer}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasGroupRow}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Viewbox StretchDirection="DownOnly">
                        <TextBlock Text="{Binding GroupNumber}" FontWeight="SemiBold" FontSize="{Binding Overlay.FontSize}"
                               VerticalAlignment="Center" />
                    </Viewbox>
                </Border>

                <Grid>
                    <local:TabBar ItemsSource="{Binding OuterTabs}" ShowUngrouped="{Binding HasUngroupedTabs}"
                                  Visibility="{Binding HasGroupRow, Converter={StaticResource BoolToVisibility}}" />
                    <local:TabBar ItemsSource="{Binding WindowTabs}">
                        <local:TabBar.Style>
                            <Style TargetType="local:TabBar">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGroupRow}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:TabBar.Style>
                    </local:TabBar>
                </Grid>
            </DockPanel>
        </Border>
        <Border Height="{Binding RowGap}" Visibility="{Binding ShowUngroupedRow, Converter={StaticResource BoolToVisibility}}" />
        <Border Height="{Binding RowHeight}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True"
                Visibility="{Binding ShowUngroupedRow, Converter={StaticResource BoolToVisibility}}">
            <local:TabBar ItemsSource="{Binding WindowTabs}" />
        </Border>
    </StackPanel>
</UserControl>
