<UserControl x:Class="wintabs.Controls.TabBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:wintabs.Controls"
             xmlns:viewmodels="clr-namespace:wintabs.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:TilingPanelViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
        <StackPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=local:TabBar}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:TilingNodeTab HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DataContext="{Binding}">
                            <local:TilingNodeTab.Style>
                                <Style TargetType="local:TilingNodeTab">
                                    <Setter Property="Margin" Value="0,2,2,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsContainer}" Value="True">
                                            <Setter Property="Margin" Value="0,0,2,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:TilingNodeTab.Style>
                        </local:TilingNodeTab>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button x:Name="UngroupedDropTab" Content="Ungrouped" Command="{Binding SelectUngroupedCommand}" Padding="6,0"
                    Margin="0,0,2,0" FontSize="{Binding Overlay.FontSize}" FontWeight="Bold"
                    Visibility="{Binding ShowUngrouped, RelativeSource={RelativeSource AncestorType=local:TabBar}, Converter={StaticResource BoolToVisibility}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Opacity" Value="0.55" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource GroupNumberBadgeStyle}"
                                                    Margin="0,0,5,0" PreviewMouseLeftButtonDown="OnUngroupedNumberMouseDown">
                                                <Viewbox StretchDirection="DownOnly">
                                                    <TextBlock Text="{Binding GroupNumber}" />
                                                </Viewbox>
                                            </Border>
                                            <ContentPresenter />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8" />
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowUngroupedRow}" Value="True" />
                                    <Condition Binding="{Binding HasFocus}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Background" Value="{Binding Overlay.FocusBorderBrush}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
