<UserControl x:Class="wintabs.Controls.TabBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:wintabs.Controls"
             xmlns:viewmodels="clr-namespace:wintabs.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:TilingPanelViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Path=ChildNodes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:TilingNodeTab Margin="0,2,1,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DataContext="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
