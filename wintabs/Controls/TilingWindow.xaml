<UserControl x:Class="wintabs.Controls.TilingWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wtc="clr-namespace:wintabs.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:wintabs.Controls"
             xmlns:viewmodels="clr-namespace:wintabs.ViewModels"
             xmlns:controls="clr-namespace:wintabs.Controls"
             d:DataContext="{d:DesignInstance Type=viewmodels:TilingWindowViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.ContextMenu>
        <ContextMenu x:Name="MoreContextMenu" Placement="Mouse">
            <MenuItem Command="{Binding AlwaysFloatCommand}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE82E;" FontSize="15" Margin="0, 0, 10, 0" />
                        <TextBlock Text="{Binding AlwaysFloatText}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>
    <Grid>
        <Border
            TextBlock.FontSize="{Binding Path=Overlay.FontSize}"
            TextBlock.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            TextBlock.FontWeight="SemiBold"
            Height="{Binding Path=ActionsHeight}"
            Margin="0,1,0,0"
            Opacity="0"
            d:Opacity="1"
            BorderThickness="1"
            BorderBrush="{DynamicResource SubtleFillColorTertiaryBrush}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            VerticalAlignment="Top"
            HorizontalAlignment="Center">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="{Binding Path=Overlay.DisplayScaling}" ScaleY="{Binding Path=Overlay.DisplayScaling}" />
            </Border.RenderTransform>
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border
                            Background="Black"
                            SnapsToDevicePixels="True"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"
                        />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <Border.Style>
                <Style TargetType="Border">
                    <!-- Every tab of a group has its bar in the same spot; only the shown one may take clicks. -->
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActionsVisibility}" Value="Visible">
                            <Setter Property="IsHitTestVisible" Value="True" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                        Storyboard.TargetProperty="(Button.Opacity)"
                                        From="0" To="1" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                        Storyboard.TargetProperty="(Button.Opacity)"
                                        From="1" To="0" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" Direction="-90" ShadowDepth="2" Opacity="0.2" Color="Black" />
            </Border.Effect>
            <wtc:SpacedStackPanel Spacing="1" Orientation="Horizontal">
                <wtc:SpacedStackPanel.Resources>
                    <ResourceDictionary>
                        <Style x:Key="ActionButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                            <Setter Property="Padding" Value="5,3" />
                            <Setter Property="TextBlock.TextAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                            <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=wtc:SpacedStackPanel}}" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ResourceDictionary>
                </wtc:SpacedStackPanel.Resources>
                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding FloatCommand}">
                    <Button.ToolTip>
                        <TextBlock FontWeight="Bold" Text="Float window" />
                    </Button.ToolTip>
                    <Viewbox Width="12" Height="12" Stretch="Uniform">
                        <controls:SvgIcon Icon="float" Color="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Viewbox>
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource ActionButtonStyle}" Click="OnMoreClick">
                    <Button.ToolTip>
                        <TextBlock FontWeight="Bold" Text="More options" />
                    </Button.ToolTip>
                    <TextBlock Width="12" Height="20" VerticalAlignment="Center" FontSize="12" FontFamily="Segoe MDL2 Assets" Text="&#xE712;" />
                </Button>
            </wtc:SpacedStackPanel>
        </Border>
    </Grid>
</UserControl>
