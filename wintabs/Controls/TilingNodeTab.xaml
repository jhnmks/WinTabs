<UserControl x:Class="wintabs.Controls.TilingNodeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:wintabs.Controls"
             xmlns:viewmodels="clr-namespace:wintabs.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:TilingNodeViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="18" d:DesignWidth="64">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type Button}" x:Key="TabButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Background}" />
                                <Border x:Name="ActiveFill" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{Binding Overlay.FocusBorderBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActiveTab}" Value="True">
                                    <Setter TargetName="ActiveFill" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.8" />
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsActiveTab}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.InputBindings>
            <MouseBinding
                MouseAction="MiddleClick"
                Command="{Binding CloseCommand}"
                CommandParameter="{Binding}" />
        </Grid.InputBindings>
        <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource TabButton}" BorderThickness="0" Padding="0"
                        Command="{Binding PrimaryActionCommand}" CommandParameter="{Binding}"
                        PreviewMouseLeftButtonDown="OnTabMouseDown">
            <Button.ContextMenu>
                <ContextMenu x:Name="TabMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="OnMenuOpened" Closed="OnMenuClosed" StaysOpen="False">
                    <MenuItem x:Name="TileLeft" Header="Tile left" Command="{Binding SplitTabCommand}" CommandParameter="Left" />
                    <MenuItem x:Name="TileRight" Header="Tile right" Command="{Binding SplitTabCommand}" CommandParameter="Right" />
                    <MenuItem x:Name="TileAbove" Header="Tile above" Command="{Binding SplitTabCommand}" CommandParameter="Up" />
                    <MenuItem x:Name="TileBelow" Header="Tile below" Command="{Binding SplitTabCommand}" CommandParameter="Down" />
                    <Separator x:Name="ContainerSeparator" />
                    <MenuItem x:Name="WrapItem" Header="Put in new Group" Command="{Binding WrapInContainerCommand}" />
                    <MenuItem x:Name="MoveToContainerItem" Header="Move to group" />
                    <MenuItem x:Name="RenameItem" Header="Rename group" Command="{Binding RenameCommand}" />
                    <MenuItem x:Name="GroupColorItem" Header="Group color" />
                    <MenuItem x:Name="UnpackItem" Header="Unpack group" Command="{Binding UnpackCommand}" />
                </ContextMenu>
            </Button.ContextMenu>
            <Button.ToolTip>
                <StackPanel>
                    <local:TilingNodeCaptionBlock HorizontalAlignment="Left" TextBlock.FontWeight="Bold" DataContext="{Binding}" />
                    <TextBlock>
                        • <Run Text="Single click to focus" />
                    </TextBlock>
                </StackPanel>
            </Button.ToolTip>

            <!-- Layout: [6 inset][text][6 gap][X slot][6 inset]. Equal insets centre the text + X group. -->
            <Grid Margin="6,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Margin="0,0,6,0" Content="{Binding}" Focusable="False" VerticalAlignment="Center">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type viewmodels:TilingWindowViewModel}">
                            <TextBlock Text="{Binding AppName}" FontSize="{Binding Overlay.FontSize}" VerticalAlignment="Center" />
                        </DataTemplate>
                        <!-- The group tint stays visible even when another group is selected. -->
                        <DataTemplate DataType="{x:Type viewmodels:TilingPanelViewModel}">
                            <Border Background="{Binding GroupColorBrush}" CornerRadius="4" Padding="4,0">
                                <StackPanel Orientation="Horizontal" TextBlock.FontWeight="Bold">
                                    <Border Style="{StaticResource GroupNumberBadgeStyle}" Margin="0,0,5,0"
                                            PreviewMouseLeftButtonDown="OnGroupNumberMouseDown">
                                        <Viewbox StretchDirection="DownOnly">
                                            <TextBlock Text="{Binding GroupNumber}" FontSize="{Binding Overlay.FontSize}" />
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="{Binding Overlay.FontSize}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ChildNodes.Count, StringFormat={} ({0})}" FontSize="{Binding Overlay.FontSize}"
                                               Opacity="0.7" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
                <Border Grid.Column="1" Width="{Binding Overlay.IconSize}" />
            </Grid>
        </Button>
        <!-- Sits outside the tab button so inactive-tab fading never dims it; aligned to the X slot above. -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                Width="{Binding Overlay.IconSize}" Height="{Binding Overlay.IconSize}" Focusable="False"
                ToolTip="Close" AutomationProperties.Name="Close"
                Command="{Binding CloseCommand}" CommandParameter="{Binding}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#C42B1C" CornerRadius="3">
                                    <Path Data="M 0,0 L 6,6 M 6,0 L 0,6" Stroke="White" StrokeThickness="1.25"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=local:TilingNodeTab}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- Closing a container would close every app in it; close its tabs one by one instead. -->
                        <DataTrigger Binding="{Binding IsContainer}" Value="True">
                            <Setter Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
