<UserControl x:Class="wintabs.Pages.Settings.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wtc="clr-namespace:wintabs.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <wtc:SpacedStackPanel MaxWidth="1000" Margin="{StaticResource SettingsPageMargin}" Spacing="4">
        <TextBlock Text="User guide" Style="{StaticResource SettingsPageTitleStyle}" />

        <Border Style="{StaticResource SettingsItemStyle}" Padding="20">
            <StackPanel>
                <TextBlock Text="WinTabs" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="{Binding Version, StringFormat=Version {0}}" />
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                           Text="WinTabs groups your open windows into tabs, like the tabs in a web browser, but for any app on Windows." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsItemStyle}" Margin="0,12,0,0" Padding="20">
            <StackPanel x:Name="Manual" />
        </Border>

        <TextBlock Text="Project and license" Style="{StaticResource SettingsSectionStyle}" />
        <Border Style="{StaticResource SettingsItemStyle}">
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                <Run Text="WinTabs is distributed under the PolyForm Perimeter License. It builds on WinMan and WinMan.Windows by Vesko Karaganev (MIT)." />
                <LineBreak />
                <Hyperlink NavigateUri="https://github.com/jhnmks/WinTabs" RequestNavigate="OnRequestNavigate">github.com/jhnmks/WinTabs</Hyperlink>
            </TextBlock>
        </Border>
    </wtc:SpacedStackPanel>
</UserControl>
