<UserControl x:Class="wintabs.Pages.Settings.ShortcutsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wtc="clr-namespace:wintabs.Controls"
             xmlns:models="clr-namespace:wintabs.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <CollectionViewSource x:Key="Grouped" Source="{x:Static models:ShortcutCatalog.All}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Section" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <wtc:SpacedStackPanel MaxWidth="1000" Margin="{StaticResource SettingsPageMargin}" Spacing="4">
        <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SettingsPageTitleStyle}" />

        <Border Style="{StaticResource SettingsItemStyle}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Content="Show cheat sheet" Click="OnShowCheatSheet" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="These shortcuts work anywhere in Windows while WinTabs is running." TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap"
                               Text="Press Ctrl + Win + / at any time for a quick reference. Changing the shortcuts will be possible in a future version." />
                </StackPanel>
            </DockPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Source={StaticResource Grouped}}" Grid.IsSharedSizeScope="True" Focusable="False">
            <ItemsControl.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SettingsSectionStyle}" />
                                            <!-- One card per section; rows inside are separated by thin dividers. -->
                                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <ItemsPresenter />
                                            </Border>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ShortcutInfo}">
                    <Border x:Name="Row" Padding="16,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" Text="{Binding Description}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" Content="{Binding Keys}" ContentTemplate="{StaticResource KeyComboTemplate}" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <!-- No divider above the first row of each card. -->
                        <DataTrigger Binding="{Binding IsFirstInSection}" Value="True">
                            <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Mouse" Style="{StaticResource SettingsSectionStyle}" />
        <Border Style="{StaticResource SettingsItemStyle}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Tabs and groups" />
                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap"
                           Text="Click a tab to switch to it, middle-click or use the × to close it, and right-click to tile it beside its group. Drag a window by its title bar to move it into another group. Drag the red number badge or empty tab bar space to move a whole group." />
            </StackPanel>
        </Border>
    </wtc:SpacedStackPanel>
</UserControl>
