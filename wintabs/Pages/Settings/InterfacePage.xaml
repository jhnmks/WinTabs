<UserControl x:Class="wintabs.Pages.Settings.InterfacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wtc="clr-namespace:wintabs.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewmodels="clr-namespace:wintabs.ViewModels"
    xmlns:models="clr-namespace:wintabs.Models"
    d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="900" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="SettingSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Width" Value="180" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="2" />
        </Style>
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>
    <wtc:SpacedStackPanel MaxWidth="1000" Margin="{StaticResource SettingsPageMargin}" Spacing="4">
        <TextBlock Text="Interface" Style="{StaticResource SettingsPageTitleStyle}" />

        <TextBlock Text="Theme" Style="{StaticResource SettingsSectionStyle}" />
        <Border Style="{StaticResource SettingsItemStyle}">
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" Margin="16,0,0,0" MinWidth="200" VerticalAlignment="Center" SelectedValuePath="Tag"
                          SelectedValue="{Binding Appearance, Mode=TwoWay}"
                          AutomationProperties.Name="Appearance">
                    <ComboBoxItem Content="Follow Windows" Tag="{x:Static models:AppearanceMode.System}" />
                    <ComboBoxItem Content="Light" Tag="{x:Static models:AppearanceMode.Light}" />
                    <ComboBoxItem Content="Dark" Tag="{x:Static models:AppearanceMode.Dark}" />
                </ComboBox>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Appearance" />
                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Light, dark, or match Windows." />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingsItemStyle}">
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" Margin="16,0,0,0" MinWidth="200" VerticalAlignment="Center"
                          ItemsSource="{Binding FocusBorderSwatches}" SelectedValuePath="Name"
                          SelectedValue="{Binding FocusBorderColor, Mode=TwoWay}"
                          AutomationProperties.Name="Active tab color">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,3,0" Background="{Binding LatteBrush}" />
                                <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,8,0" Background="{Binding MochaBrush}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Active tab color" />
                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Catppuccin Latte in light mode, Mocha in dark mode." />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Text="Tab bar" Style="{StaticResource SettingsSectionStyle}" />
        <Border Style="{StaticResource SettingsItemStyle}">
            <DockPanel>
                <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=PanelHeightSlider, StringFormat={}{0} px}" />
                <Slider x:Name="PanelHeightSlider" DockPanel.Dock="Right" Style="{StaticResource SettingSlider}" Minimum="16" Maximum="32"
                        Value="{Binding PanelHeight, Mode=TwoWay}" AutomationProperties.Name="Tab bar height" />
                <TextBlock VerticalAlignment="Center" Text="Tab bar height" />
            </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingsItemStyle}">
            <DockPanel>
                <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=PanelFontSizeSlider, StringFormat={}{0} px}" />
                <Slider x:Name="PanelFontSizeSlider" DockPanel.Dock="Right" Style="{StaticResource SettingSlider}" Minimum="10" Maximum="{Binding PanelHeight, Mode=OneWay}"
                        Value="{Binding PanelFontSize, Mode=TwoWay}" AutomationProperties.Name="Tab text size" />
                <TextBlock VerticalAlignment="Center" Text="Tab text size" />
            </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingsItemStyle}">
            <DockPanel>
                <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=WindowPaddingSlider, StringFormat={}{0} px}" />
                <Slider x:Name="WindowPaddingSlider" DockPanel.Dock="Right" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="32"
                        Value="{Binding WindowPadding, Mode=TwoWay}" AutomationProperties.Name="Window gap" />
                <TextBlock VerticalAlignment="Center" Text="Window gap" />
            </DockPanel>
        </Border>
    </wtc:SpacedStackPanel>
</UserControl>
