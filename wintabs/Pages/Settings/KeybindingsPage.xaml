<UserControl x:Class="wintabs.Pages.Settings.KeybindingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wtc="clr-namespace:wintabs.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:wintabs.Pages.Settings" xmlns:controls="clr-namespace:wintabs.Controls" xmlns:viewmodels="clr-namespace:wintabs.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <wtc:SpacedStackPanel MaxWidth="1000" Margin="{StaticResource SettingsPageMargin}" Spacing="4">
            <TextBlock Text="Keybindings" Style="{StaticResource SettingsPageTitleStyle}" />

            <Border Style="{StaticResource SettingsItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Activation hotkey" />
                    <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedActivationHotkey, Mode=TwoWay}" ItemsSource="{Binding ActivationHotkeyOptions}" Width="200"
                              AutomationProperties.Name="Activation hotkey">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" MinWidth="0"
                              IsChecked="{Binding ActivateOnCapsLock, Mode=TwoWay}"
                              ToolTip="You do not have to release the key to activate. ⇪ Caps Lock will no longer function normally" ToolTipService.InitialShowDelay="0">
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Margin="0" FontSize="14" Text="Use ⇪ Caps Lock as the activation hotkey" />
                    </CheckBox>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Path=KeybindingGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Path=GroupKey}" Style="{StaticResource SettingsSectionStyle}" />
                            <ItemsControl ItemsSource="{Binding Path=Keybindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingsItemStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Caption, Mode=OneWay}" />
                                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" Text="{Binding Description, Mode=OneWay}" />
                                                </StackPanel>

                                                <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" MinWidth="0"
                                                          IsChecked="{Binding IsDirectMode, Mode=TwoWay}"
                                                          ToolTipService.InitialShowDelay="0">
                                                    <CheckBox.ToolTip>
                                                        <TextBlock MaxWidth="360" TextWrapping="Wrap">
                                                            <Run Text="Registers the keybinding as a system hotkey, allowing it to be used without the Activation hotkey. The keybinding must use at least one modifier key (Ctrl, Shift, Alt, Win)." />
                                                            <LineBreak />
                                                            <LineBreak />
                                                            <Run Text="Windows will not allow WinTabs to register a hotkey that is already used by it or another application." />
                                                        </TextBlock>
                                                    </CheckBox.ToolTip>
                                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Margin="0" FontSize="14" Text="Use without the activation hotkey" />
                                                </CheckBox>

                                                <controls:KeyPressBox Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Pattern="{Binding Pattern, Mode=TwoWay}" Width="200">
                                                    <controls:KeyPressBox.Style>
                                                        <Style>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Path=HasErrors}" Value="True">
                                                                    <Setter Property="controls:KeyPressBox.Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:KeyPressBox.Style>
                                                </controls:KeyPressBox>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <wtc:SpacedStackPanel HorizontalAlignment="Stretch" Orientation="Vertical" IsItemsHost="True" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                        </StackPanel>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <wtc:SpacedStackPanel HorizontalAlignment="Stretch" Orientation="Vertical" IsItemsHost="True" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

    </wtc:SpacedStackPanel>
</UserControl>
