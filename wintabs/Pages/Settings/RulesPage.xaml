<UserControl x:Class="wintabs.Pages.Settings.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wtc="clr-namespace:wintabs.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:wintabs.ViewModels"
             xmlns:controls="clr-namespace:wintabs.Controls"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <wtc:SpacedStackPanel MaxWidth="1000" Margin="{StaticResource SettingsPageMargin}" Spacing="4">
        <TextBlock Text="Rules" Style="{StaticResource SettingsPageTitleStyle}" />

        <TextBlock Text="Floating windows" Style="{StaticResource SettingsSectionStyle}" />
        <Border Style="{StaticResource SettingsItemStyle}">
            <StackPanel>
                <TextBlock Text="Automatically float by process name" />
                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" Margin="0,2,0,12" Text="Floating mode will be automatically enabled for windows belonging to one of the processes. Enter one process name per line, excluding the &quot;.exe&quot; extension (e.g. &quot;explorer&quot;). The matching is not case-sensitive and you may use regular expressions." />
                <controls:StringsListBox ItemsSource="{Binding ProcessIgnoreList, Mode=TwoWay}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsItemStyle}">
            <StackPanel>
                <TextBlock Text="Automatically float by window class" />
                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" Margin="0,2,0,12" Text="Floating mode will be automatically enabled for windows with a matching window class. The matching is not case-sensitive and you may use regular expressions." />
                <controls:StringsListBox ItemsSource="{Binding ClassIgnoreList, Mode=TwoWay}" />
            </StackPanel>
        </Border>
    </wtc:SpacedStackPanel>
</UserControl>
