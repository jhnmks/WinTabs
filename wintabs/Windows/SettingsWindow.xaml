<Window x:Class="wintabs.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:collections="clr-namespace:System.Collections;assembly=mscorlib"
        xmlns:viewmodels="clr-namespace:wintabs.ViewModels"
        xmlns:pages="clr-namespace:wintabs.Pages.Settings"
        mc:Ignorable="d"
        Height="680"
        Width="900"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontSize="14"
        Title="WinTabs Settings"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Focusable="True">
    <DockPanel>
        <DockPanel DockPanel.Dock="Left" LastChildFill="False" Width="220" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <ListView
                x:Name="PagesList"
                DockPanel.Dock="Top"
                Margin="4,8"
                AutomationProperties.Name="Settings"
                SelectionMode="Single"
                SelectedValuePath="Page"
                SelectedIndex="0"
                SelectionChanged="PagesList_SelectionChanged">
                <ListView.ItemsSource>
                    <collections:ArrayList>
                        <viewmodels:PageItem Page="{x:Type pages:GeneralPage}">
                            <viewmodels:PageItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <TextBlock FontSize="16" FontFamily="Segoe MDL2 Assets" Text="&#xE713;" />
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="General" />
                                </StackPanel>
                            </viewmodels:PageItem.Header>
                        </viewmodels:PageItem>
                        <viewmodels:PageItem Page="{x:Type pages:InterfacePage}">
                            <viewmodels:PageItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <TextBlock FontSize="16" FontFamily="Segoe MDL2 Assets" Text="&#xE771;" />
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Interface" />
                                </StackPanel>
                            </viewmodels:PageItem.Header>
                        </viewmodels:PageItem>
                        <viewmodels:PageItem Page="{x:Type pages:KeybindingsPage}">
                            <viewmodels:PageItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <TextBlock FontSize="16" FontFamily="Segoe MDL2 Assets" Text="&#xF210;" />
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Keybindings" />
                                </StackPanel>
                            </viewmodels:PageItem.Header>
                        </viewmodels:PageItem>
                        <viewmodels:PageItem Page="{x:Type pages:RulesPage}">
                            <viewmodels:PageItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <TextBlock FontSize="16" FontFamily="Segoe MDL2 Assets" Text="&#xE82D;" />
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Rules" />
                                </StackPanel>
                            </viewmodels:PageItem.Header>
                        </viewmodels:PageItem>
                    </collections:ArrayList>
                </ListView.ItemsSource>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding Header}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button DockPanel.Dock="Bottom" Margin="8,8,8,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8"
                    Click="OnQuitButtonClick" TextBlock.Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    AutomationProperties.Name="Quit">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="16" FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Quit" />
                </StackPanel>
            </Button>
        </DockPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border x:Name="PageContent" />
        </ScrollViewer>
    </DockPanel>
</Window>
