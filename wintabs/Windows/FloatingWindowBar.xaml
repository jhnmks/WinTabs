<Window x:Class="wintabs.Windows.FloatingWindowBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wtc="clr-namespace:wintabs.Controls"
        Title="wintabsFloatingWindowBar"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Left="-10000"
        Top="-10000"
        FontSize="12">
    <!-- Same look as the actions shown on top of a tab (Controls/TilingWindow.xaml). -->
    <Border Margin="4,0,4,6"
            BorderThickness="1"
            BorderBrush="{DynamicResource SubtleFillColorTertiaryBrush}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="{DynamicResource ControlCornerRadius}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="4" Direction="-90" ShadowDepth="2" Opacity="0.2" Color="Black" />
        </Border.Effect>
        <Border.Resources>
            <Style x:Key="ActionButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                <Setter Property="Padding" Value="5,3" />
                <Setter Property="Height" Value="24" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Border.Resources>
        <wtc:SpacedStackPanel Spacing="1" Orientation="Horizontal">
            <Button x:Name="RetabButton" Style="{StaticResource ActionButtonStyle}" Click="OnRetabClick">
                <Button.ToolTip>
                    <TextBlock FontWeight="Bold" Text="Put back in tabs" />
                </Button.ToolTip>
                <Viewbox Width="12" Height="12" Stretch="Uniform">
                    <wtc:SvgIcon Icon="float" Color="{DynamicResource TextFillColorPrimaryBrush}" />
                </Viewbox>
            </Button>
            <Button x:Name="MoreButton" Style="{StaticResource ActionButtonStyle}" Click="OnMoreClick">
                <Button.ToolTip>
                    <TextBlock FontWeight="Bold" Text="More options" />
                </Button.ToolTip>
                <Button.ContextMenu>
                    <ContextMenu x:Name="MoreMenu" Placement="Bottom" Closed="OnMenuClosed">
                        <MenuItem Click="OnAlwaysFloatClick">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE82E;" FontSize="15" Margin="0,0,10,0" />
                                    <TextBlock x:Name="AlwaysFloatText" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
                <TextBlock Width="12" VerticalAlignment="Center" FontSize="12" FontFamily="Segoe MDL2 Assets" Text="&#xE712;" />
            </Button>
        </wtc:SpacedStackPanel>
    </Border>
</Window>
