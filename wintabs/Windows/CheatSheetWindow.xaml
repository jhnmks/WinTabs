<Window x:Class="wintabs.Windows.CheatSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:wintabs.Models"
        Title="WinTabs shortcuts"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        SizeToContent="WidthAndHeight"
        FontSize="14"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="Key" TargetType="Border" BasedOn="{StaticResource KeyChipStyle}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow inside the transparent window. -->
    <Border Margin="24" Padding="24,20" MinWidth="520" CornerRadius="8"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="-90" Opacity="0.25" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SettingsDescriptionStyle}" Margin="16,0,0,0"
                           Text="Esc to close" />
                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
            </DockPanel>

            <ItemsControl x:Name="Shortcuts" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ShortcutInfo}">
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding Keys}" Margin="0,0,20,0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Plus" Text="+" Margin="4,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Border Style="{StaticResource Key}">
                                                <TextBlock Text="{Binding}" />
                                            </Border>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                <Setter TargetName="Plus" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
