<Window x:Class="wintabs.Windows.CheatSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:wintabs.Models"
        Title="WinTabs shortcuts"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        SizeToContent="WidthAndHeight"
        Opacity="0"
        FontSize="14"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <CollectionViewSource x:Key="Grouped" Source="{x:Static models:ShortcutCatalog.All}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Section" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow inside the transparent window. -->
    <Border Margin="24" Padding="24,20,24,16" MinWidth="520" CornerRadius="8"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="-90" Opacity="0.25" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SettingsDescriptionStyle}" Margin="16,0,0,0"
                           Text="Esc to close" />
                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Source={StaticResource Grouped}}" Grid.IsSharedSizeScope="True" Focusable="False">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                        CornerRadius="6" Padding="12,4">
                                                    <ItemsPresenter />
                                                </Border>
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ShortcutInfo}">
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding Keys}" ContentTemplate="{StaticResource KeyComboTemplate}" Margin="0,0,24,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
